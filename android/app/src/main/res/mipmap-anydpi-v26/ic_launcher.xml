<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: the launcher masks this to whatever shape the device uses
     (circle, squircle, teardrop), so the bars are drawn well inside the safe
     zone in ic_launcher_foreground and the background is a flat colour. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
